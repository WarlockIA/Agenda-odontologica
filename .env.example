# ===================================================
# Configuracion de Entorno para Agenda Odontologica
# ===================================================

# Puerto publico de la aplicacion en el host (Frontend Nginx)
PORT=80
FRONTEND_PORT=80

# Puerto interno del servidor Node.js
BACKEND_PORT=3000

# Secreto JWT seguro (minimo 64 caracteres para produccion)
JWT_SECRET=c8f5d1e2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0

# Modo de ejecucion
NODE_ENV=production
IS_DOCKER=true
TRUST_PROXY=true

# Rutas persistentes montadas en volumenes Docker
DB_PATH=/app/data/database.db
UPLOAD_PATH=/app/uploads

# Inicializacion de usuarios por defecto (Dr. Luis D. Reynaga / Sra. Laura Gomez)
SEED_DEFAULT_USERS=true

# Frecuencia de respaldos automaticos del servicio DB (en segundos, 21600 = 6 horas)
BACKUP_INTERVAL=21600

/* ==========================================================================
   ANIMACIONES DE ENTRADA (SETTINGS TAB)
   ========================================================================== */

@keyframes settingsFadeUp {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

#tab-settings-content:not([hidden]) .section-header {
  animation: settingsFadeUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

#tab-settings-content:not([hidden]) .settings-tabs-nav {
  opacity: 0;
  animation: settingsFadeUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.1s forwards;
}

#tab-settings-content:not([hidden]) .settings-tabs-content {
  opacity: 0;
  animation: settingsFadeUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s forwards;
}
